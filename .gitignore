# Python
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
.python-version

# Node
node_modules/
clients/*/dist/
*.tsbuildinfo

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Ansible collections, fetched by scripts/fetch_tools.sh from Galaxy. Vendored dependencies are
# never tracked here: check_repo.sh G13 fails on any of them, after node_modules was committed
# to another repository in this toolset by a git add -A.
collections/

# Terraform and OpenTofu
# .build holds the zip the archive_file data source writes. It is a build output that Terraform
# regenerates deterministically from lambda/handler.py on every plan, and it was tracked here
# only because an apply happened to run before a git add. A committed binary nobody regenerates
# is the same defect as a committed plan nobody regenerates.
modules/*/.build/
.terraform/
.terraform.lock.hcl.bak
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
